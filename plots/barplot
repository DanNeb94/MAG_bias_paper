install.packages("reshape")
install.packages("ggplot")
library(reshape)
library(ggplot2)

##### Data Preparation #####

pc = read.csv("phyla_final.csv", header = TRUE)
pcm = melt(pc, id = c("Sample"))
colours = c("#FF00C1", "#FF8BE3", "#1FDE1A", "#86F183", "#C6F6C5", "#0BC3DE", "#47DCF1", "#E0D00C", "#B96393", "#FFC0CB", "#FF1F00", "#8B4513", "#F5DEB3", "#CBCBCB")
pcm$Sample <- factor(pcm$Sample,levels=unique(pcm$Sample))

##### Key Indentation #####

levels(pcm$variable) <- c(
  'Proteobacteria',
  '    Limnohabitans',
  'Cyanobacteria',
  '    Planktothrix',
  '    Microcystis',
  'Bacteroidota',
  '    Flavobacterium',
  levels(pcm$variable)[8:length(levels(pcm$variable))]
)

##### Create the Plot #####

mx <- ggplot(pcm, aes(x = Sample, fill = variable, y = value)) +
  geom_bar(stat = "identity", colour = "black") +
  theme(axis.text.x = element_text(angle = 90, size = 14, colour = "black", vjust = 0.5, hjust = 1, face = "bold"),
        axis.title.y = element_text(size = 16, face = "bold"),
        legend.title = element_text(size = 16, face = "bold"),
        legend.text = element_text(size = 12, face = "bold", colour = "black"),
        axis.text.y = element_text(colour = "black", size = 12, face = "bold")) +
  scale_y_continuous(expand = c(0, 0), limits = c(0, 100)) +
  labs(x = "", y = "Composition (%)", fill = "Phyla") +
  scale_fill_manual(values = colours)

mx

ggsave("barplot_test.png", plot = mx, scale = 1, dpi = 600)

save.image("RW_read_classification_barplot_environment.RData")
